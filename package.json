{
  "name": "project-fram",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@11.4.2",
  "scripts": {
    "build": "tsc --project tsconfig.node.json && tsc --project tsconfig.react.json",
    "test": "npm run typecheck",
    "typecheck": "tsc --project tsconfig.node.json --noEmit && tsc --project tsconfig.react.json --noEmit",
    "lint:code": "eslint . --max-warnings=0",
    "lint:styles": "stylelint '**/*.{css,scss}' --allow-empty-input",
    "lint:format": "prettier --check .",
    "lint": "npm run lint:code && npm run lint:styles && npm run lint:format && npm run typecheck",
    "lint:fix": "eslint . --fix && stylelint '**/*.{css,scss}' --fix --allow-empty-input && prettier --write .",
    "format": "prettier --write .",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2"
  }
}
